{
  "name": "earth-lab",
  "version": "0.1.0",
  "description": "A living 3D globe of open scientific data: earthquakes, satellites, natural events and wind, with a time machine to replay the last 30 days.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "HMJ07",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMJ07/earth-lab.git"
  },
  "keywords": [
    "threejs",
    "webgl",
    "globe",
    "data-visualization",
    "earthquakes",
    "satellites",
    "open-data",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "satellite.js": "^7.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://hmj07.github.io/earth-lab/",
  "bugs": {
    "url": "https://github.com/HMJ07/earth-lab/issues"
  }
}
